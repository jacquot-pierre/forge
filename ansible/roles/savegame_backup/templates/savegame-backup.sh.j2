#!/bin/sh
# Deploy via ansible (role savegame_backup)
# Archives {{ savegame_backup_source }} then prunes: archives older than {{ savegame_backup_keep_days }} days are
# deleted, except the {{ savegame_backup_keep_min }} most recent ones (the VM is often off for days).
set -eu

dest="{{ savegame_backup_dir }}"
archive="$dest/{{ savegame_backup_name }}-$(date +%Y%m%d-%H%M).tar.gz"

tar -C "{{ savegame_backup_source | dirname }}" -czf "$archive.tmp" "{{ savegame_backup_source | basename }}"
mv "$archive.tmp" "$archive"
echo "Created $archive ($(du -h "$archive" | cut -f1))"

ls -1t "$dest"/{{ savegame_backup_name }}-*.tar.gz | tail -n +{{ savegame_backup_keep_min | int + 1 }} | while read -r old; do
  find "$old" -mtime +{{ savegame_backup_keep_days | int - 1 }} -print -delete
done
