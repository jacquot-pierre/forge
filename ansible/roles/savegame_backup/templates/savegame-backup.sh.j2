#!/bin/sh
# Deploy via ansible (role savegame_backup)
# Archives {{ savegame_backup_source }} then keeps only the {{ savegame_backup_keep }} most recent archives.
set -eu

dest="{{ savegame_backup_dir }}"
archive="$dest/{{ savegame_backup_name }}-$(date +%Y%m%d-%H%M).tar.gz"

tar -C "{{ savegame_backup_source | dirname }}" -czf "$archive.tmp" "{{ savegame_backup_source | basename }}"
mv "$archive.tmp" "$archive"
echo "Created $archive ($(du -h "$archive" | cut -f1))"

ls -1t "$dest"/{{ savegame_backup_name }}-*.tar.gz | tail -n +{{ savegame_backup_keep | int + 1 }} | while read -r old; do
  rm -v -- "$old"
done
