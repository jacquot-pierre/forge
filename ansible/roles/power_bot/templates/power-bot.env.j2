# Deploy via ansible (role power_bot). Root only: contains the Discord and Proxmox secrets.
DISCORD_TOKEN={{ power_bot_discord_token }}
DISCORD_GUILD_ID={{ power_bot_discord_guild_id }}
DISCORD_PLAYER_ROLE_IDS={{ power_bot_discord_player_role_ids | join(',') }}
DISCORD_ADMIN_USER_IDS={{ power_bot_discord_admin_user_ids | join(',') }}
PROXMOX_URL={{ power_bot_proxmox_url }}
PROXMOX_NODE={{ power_bot_proxmox_node }}
PROXMOX_TOKEN_ID={{ power_bot_proxmox_token_id }}
PROXMOX_TOKEN_SECRET={{ power_bot_proxmox_token_secret }}
PROXMOX_VERIFY_TLS={{ power_bot_proxmox_verify_tls | bool | lower }}
WOL_MAC={{ power_bot_wol_mac }}
WOL_BROADCAST={{ power_bot_wol_broadcast }}
GAMES={{ power_bot_games | join(',') }}
BOOT_TIMEOUT={{ power_bot_boot_timeout | int }}
