# Deploy via ansible
# BeamMP reads its settings from these variables. With BEAMMP_PROVIDER_DISABLE_CONFIG the server uses no
# ServerConfig.toml at all: it would otherwise rewrite that file (AuthKey included) at each start.
# Strings are JSON-quoted: systemd EnvironmentFile understands the same \" and \ escapes.
BEAMMP_PROVIDER_DISABLE_CONFIG=true
BEAMMP_AUTH_KEY={{ (beammp_auth_key) | to_json(ensure_ascii=False) }}
BEAMMP_NAME={{ (beammp_name) | to_json(ensure_ascii=False) }}
BEAMMP_DESCRIPTION={{ (beammp_description) | to_json(ensure_ascii=False) }}
BEAMMP_TAGS={{ (beammp_tags) | to_json(ensure_ascii=False) }}
BEAMMP_MAP={{ (beammp_map) | to_json(ensure_ascii=False) }}
BEAMMP_PORT={{ beammp_port | int }}
BEAMMP_MAX_PLAYERS={{ beammp_max_players | int }}
BEAMMP_MAX_CARS={{ beammp_max_cars | int }}
BEAMMP_PRIVATE={{ beammp_private | bool | lower }}
BEAMMP_ALLOW_GUESTS={{ beammp_allow_guests | bool | lower }}
BEAMMP_LOG_CHAT={{ beammp_log_chat | bool | lower }}
BEAMMP_DEBUG={{ beammp_debug | bool | lower }}
